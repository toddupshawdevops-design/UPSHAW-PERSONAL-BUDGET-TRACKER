$host = "localhost";
$user = "ecpi_user";
$password = "";
$database = "todd_budget_tracker";

$conn = new mysqli($host, $user, $password, $database);

if ($conn->connect_error) {
    die("Database Connection Failed: " . $conn->connect_error);
}

$conn->set_charset("utf8mb4");

$message = "";
$error = "";

// ============================================================
// ADD TRANSACTION
// ============================================================
if (isset($_POST["add_transaction"])) {

    $type = $_POST["transaction_type"];
    $amount = $_POST["amount"];
    $category = $_POST["category"];
    $date = $_POST["transaction_date"];
    $description = $_POST["description"];

    $sql = "INSERT INTO transactions
            (transaction_type, amount, category, transaction_date, description)
            VALUES (?, ?, ?, ?, ?)";

    $stmt = $conn->prepare($sql);

    if ($stmt === false) {
        $error = "Add Transaction Error: " . $conn->error;
    } else {

        $stmt->bind_param(
            "sdsss",
            $type,
            $amount,
            $category,
            $date,
            $description
        );

        if ($stmt->execute()) {
            $message = "Transaction added successfully.";
        } else {
            $error = "Could not add transaction: " . $stmt->error;
        }

        $stmt->close();
    }
}

// ============================================================
// LOAD TRANSACTION FOR EDIT
// ============================================================
$edit_transaction = null;

if (isset($_GET["edit"])) {

    $edit_id = intval($_GET["edit"]);

    $sql = "SELECT
                transaction_id,
                transaction_type,
                amount,
                category,
                transaction_date,
                description
            FROM transactions
            WHERE transaction_id = ?";

    $stmt = $conn->prepare($sql);

    if ($stmt === false) {
        $error = "Edit Error: " . $conn->error;
    } else {

        $stmt->bind_param("i", $edit_id);
        $stmt->execute();

        $result = $stmt->get_result();

        if ($result->num_rows > 0) {
            $edit_transaction = $result->fetch_assoc();
        } else {
            $error = "Transaction not found.";
        }

        $stmt->close();
    }
}

// ============================================================
// UPDATE TRANSACTION
// ============================================================
if (isset($_POST["update_transaction"])) {

    $id = intval($_POST["transaction_id"]);
    $type = $_POST["transaction_type"];
    $amount = $_POST["amount"];
    $category = $_POST["category"];
    $date = $_POST["transaction_date"];
    $description = $_POST["description"];

    $sql = "UPDATE transactions
            SET transaction_type = ?,
                amount = ?,
                category = ?,
                transaction_date = ?,
                description = ?
            WHERE transaction_id = ?";

    $stmt = $conn->prepare($sql);

    if ($stmt === false) {
        $error = "Update Error: " . $conn->error;
    } else {

        $stmt->bind_param(
            "sdsssi",
            $type,
            $amount,
            $category,
            $date,
            $description,
            $id
        );

        if ($stmt->execute()) {
            $message = "Transaction updated successfully.";
        } else {
            $error = "Could not update transaction: " . $stmt->error;
        }

        $stmt->close();
    }
}

// ============================================================
// DELETE TRANSACTION
// ============================================================
if (isset($_POST["delete_transaction"])) {

    $id = intval($_POST["transaction_id"]);

    $sql = "DELETE FROM transactions
            WHERE transaction_id = ?";

    $stmt = $conn->prepare($sql);

    if ($stmt === false) {
        $error = "Delete Error: " . $conn->error;
    } else {

        $stmt->bind_param("i", $id);

        if ($stmt->execute()) {
            $message = "Transaction deleted successfully.";
        } else {
            $error = "Could not delete transaction: " . $stmt->error;
        }

        $stmt->close();
    }
}

// ============================================================
// ADD SAVINGS GOAL
// ============================================================
if (isset($_POST["add_goal"])) {

    $goal_name = $_POST["goal_name"];
    $target_amount = $_POST["target_amount"];
    $current_amount = $_POST["current_amount"];
    $target_date = $_POST["target_date"];

    $sql = "INSERT INTO savings_goals
            (goal_name, target_amount, current_amount, target_date)
            VALUES (?, ?, ?, ?)";

    $stmt = $conn->prepare($sql);

    if ($stmt === false) {
        $error = "Savings Goal Error: " . $conn->error;
    } else {

        $stmt->bind_param(
            "sdds",
            $goal_name,
            $target_amount,
            $current_amount,
            $target_date
        );

        if ($stmt->execute()) {
            $message = "Savings goal added successfully.";
        } else {
            $error = "Could not add savings goal: " . $stmt->error;
        }

        $stmt->close();
    }
}

// ============================================================
// DELETE SAVINGS GOAL
// ============================================================
if (isset($_POST["delete_goal"])) {

    $id = intval($_POST["goal_id"]);

    $sql = "DELETE FROM savings_goals
            WHERE goal_id = ?";

    $stmt = $conn->prepare($sql);

    if ($stmt === false) {
        $error = "Delete Goal Error: " . $conn->error;
    } else {

