}

// ============================================================
// GET TRANSACTIONS
// ============================================================
$transactions = [];

$sql = "SELECT
            transaction_id,
            transaction_type,
            amount,
            category,
            transaction_date,
            description
        FROM transactions
        ORDER BY transaction_date DESC, transaction_id DESC";

$result = $conn->query($sql);

if ($result === false) {
    $error = "Could not read transactions table: " . $conn->error;
} else {

    while ($row = $result->fetch_assoc()) {
        $transactions[] = $row;
    }
}

// ============================================================
// GET SAVINGS GOALS
// ============================================================
$goals = [];

$sql = "SELECT
            goal_id,
            goal_name,
            target_amount,
            current_amount,
            target_date
        FROM savings_goals
        ORDER BY goal_id DESC";

$result = $conn->query($sql);

if ($result === false) {
    $error = "Could not read savings_goals table: " . $conn->error;
} else {

    while ($row = $result->fetch_assoc()) {
        $goals[] = $row;
    }
}

// ============================================================
// TOTAL INCOME
// ============================================================
$total_income = 0;

$sql = "SELECT SUM(amount) AS total
        FROM transactions
        WHERE transaction_type = 'Income'";

$result = $conn->query($sql);

if ($result) {
    $row = $result->fetch_assoc();
    $total_income = $row["total"] ?? 0;
}

// ============================================================
// TOTAL EXPENSES
// ============================================================
$total_expenses = 0;

$sql = "SELECT SUM(amount) AS total
        FROM transactions
        WHERE transaction_type = 'Expense'";

$result = $conn->query($sql);

if ($result) {
    $row = $result->fetch_assoc();
    $total_expenses = $row["total"] ?? 0;
}

// ============================================================
// CURRENT BALANCE
// ============================================================
$balance = $total_income - $total_expenses;

