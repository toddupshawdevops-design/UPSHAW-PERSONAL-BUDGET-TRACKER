                        <td>$<?php echo number_format($t['amount'], 2); ?></td>
                        <td><?php echo htmlspecialchars($t['description']); ?></td>
                        <td>
                            <a href="index.php?action=delete&id=<?php echo $t['id']; ?>" class="btn-delete" onclick="return confirm('Delete this record?');">Delete</a>
