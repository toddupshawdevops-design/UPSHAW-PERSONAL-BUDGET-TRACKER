                <?php if (!empty($transactions)): ?>
                    <?php foreach ($transactions as $t): ?>
                    <tr>
                        <td><?php echo htmlspecialchars($t['transaction_date']); ?></td>
                        <td class="<?php echo htmlspecialchars($t['type']); ?>"><?php echo htmlspecialchars($t['type']); ?></td>
